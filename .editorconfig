root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.sh]
indent_size = 2

# The nv shell script has no extension
[skills/nvim-remote/scripts/nv]
indent_size = 2

[*.lua]
indent_size = 2

[*.py]
indent_size = 4

[*.json]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown; none are used here, but
# don't strip them silently if one is ever added.
trim_trailing_whitespace = false
